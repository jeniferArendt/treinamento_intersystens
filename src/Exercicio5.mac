ROUTINE Exercicio5
Exercicio5	;
	;
	; Rotina para cadastrar X alunos
	; Os dados são armazenados em uma global ^tAluno
	; Estrutura: ^tAluno(índice, "propriedade") = valor
	;
	write !,"=== CADASTRO DE ALUNOS ==="
	;
	; Ler quantidade de alunos
	write !,"Quantos alunos deseja cadastrar? "
	read qtdAlunos
	;
	; Loop para cadastrar cada aluno
	for i=1:1:qtdAlunos {
		write !,"--- Aluno ", i, " ---"
		;
		write !,"Digite a Matrícula: "
		read matricula
		set ^tAluno(i, "matricula") = matricula
		;
		write !,"Digite o Nome Completo: "
		read nome
		set ^tAluno(i, "nome") = nome
		;
		write !,"Digite o Telefone: "
		read telefone
		set ^tAluno(i, "telefone") = telefone
		;
		write !,"Digite a Data de Nascimento (DD/MM/YYYY): "
		read dataNascimento
		set ^tAluno(i, "dataNascimento") = dataNascimento
		;
		; Ler sexo
		write !,"Digite o Sexo (M/F): "
		read sexo
		set ^tAluno(i, "sexo") = sexo
	}
	;
	; Exibir dados cadastrados
	write !,"=== DADOS CADASTRADOS ==="
	;
	for i=1:1:qtdAlunos {
		write !,"--- Aluno ", i, " ---"
		write !,"Matrícula: ", ^tAluno(i, "matricula")
		write !,"Nome: ", ^tAluno(i, "nome")
		write !,"Telefone: ", ^tAluno(i, "telefone")
		write !,"Data de Nascimento: ", ^tAluno(i, "dataNascimento")
		write !,"Sexo: ", ^tAluno(i, "sexo")
	}
	;
	quit
