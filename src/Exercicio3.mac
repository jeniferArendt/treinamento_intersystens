ROUTINE Exercicio3
Exercicio3(num1, num2, num3)	;
	;
	; 4 - Criar uma rotina (Exercício3) para receber 3 números: num1, num2 e num3.
    ;
    ; 4.1 - Exibir e contar todos os números entre num1 e num2 que, quando
    ; divididos por 11, tenham o valor do resto igual a 5.
    ; 4.2 - Exibir e contar todos os números múltiplos de 3 entre num2 e num3.
    ; 4.3 - Exibir a soma de todos os números entre num1 e num2.
	;
	set num1 = $get(num1)
	set num2 = $get(num2)
	set num3 = $get(num3)
	;
	write !,"Digite o primeiro número (num1): ",num1
	if num1 = "" read num1
	;
	write !,"Digite o segundo número (num2): ",num2
	if num2 = "" read num2
	;
	write !,"Digite o terceiro número (num3): ",num3
	if num3 = "" read num3
	;
    if num1 > num2 {
        write !,"Erro: num1 deve ser menor ou igual a num2", !
		quit
	}
	;
    if num2 > num3 {
        write !,"Erro: num2 deve ser menor ou igual a num3", !
		quit
	}
	;
	write !,"=== Números com resto 5 ao dividir por 11 ==="
	write !,"Números entre ", num1, " e ", num2, ": "
	set count1 = 0
	for i=num1:1:num2 {
		if (i#11 = 5) {
			write i, " / "
			set count1 = count1 + 1
		}
	}
	write !,"Contagem: ", count1
	;
	write !,"=== Números múltiplos de 3 ==="
	write !,"Números entre ", num2, " e ", num3, ": "
	set count2 = 0
	for i=num2:1:num3 {
		if (i#3 = 0) {
			write i, " / "
			set count2 = count2 + 1
		}
	}
	write !,"Contagem: ", count2
	;
	write !,"=== Soma de todos os números ==="
	set soma = 0
	for i=num1:1:num2 {
		set soma = soma + i
	}
	write !,"Soma de ", num1, " a ", num2, ": ", soma
	;
	quit
