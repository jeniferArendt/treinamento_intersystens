ROUTINE ExercicioLog
	;
	; Rotina de gerenciamento de log da aplicação usando Treinamento.Data.LogMensagem
	;
	quit
	;
	; 11 - Armazena a entrada do ciclo de vida do log
	;
CriarEntrada()	;
	;
	set log = ##class(Treinamento.Data.LogMensagem).CriarEntrada("CriarEntrada", "ExercicioLog")
	;
	if $isObject(log) {
		write !,"Log criado com sucesso!"
		write !,"  ID     : ", log.%Id()
		write !,"  Metodo : ", log.Metodo
		write !,"  Classe : ", log.Classe
		write !,"  Inicio : ", log.Inicio
		write !,"  Status : ", log.Status
	} else {
		write !,"Erro ao criar log."
	}
	quit

	;
	; 12 - Armazena o fim do ciclo de vida do log
	;
Finalizar()	;
	;
	set log     = ##class(Treinamento.Data.LogMensagem).CriarEntrada("Finalizar", "ExercicioLog")
	set idLog   = log.%Id()
	write !,"Log de entrada criado para teste - ID: ", idLog
	;
	set sc = ##class(Treinamento.Data.LogMensagem).Finalizar(idLog, "Concluido", "Ativo")
	;
	if sc {
		write !,"Log finalizado com sucesso!"
		write !,"  ID             : ", idLog
		write !,"  StatusProcesso : Concluido"
		write !,"  StatusCode     : OK"
	} else {
		write !,"Erro ao finalizar log: ", $system.Status.GetErrorText(sc)
	}
	quit

	;
	; 13 - Consulta logs por Status, DataInicio e DataFim
	;
ConsultaLog()	;
	;
	set status      = "Ativo"
	set dataInicio  = "2000-01-01 00:00:00"
	set dataFim     = $zdatetime($horolog, 3)
	;
	do ##class(Treinamento.Data.LogMensagem).ConsultaLog(status, dataInicio, dataFim)
	quit

	;
	; 14 - Consulta logs com paginacao por keyset (LastId)
	;
ConsultaLogPaginacao(lastId)	;
	;
	set status  = "Ativo"
	set lastId  = +$get(lastId)
	set pagSize = 3
	set dataFim = $zdatetime($horolog+1, 3)
	;
	set lista = ##class(Treinamento.VO.LogMensagem).ConsultaLogPaginacao(status, lastId, pagSize, dataFim, .ultimoId)
	;
	write !,"=== Consulta de Log com Paginacao ==="
	write !,"Status: ", status, " | Ate: ", dataFim, " | PagSize: ", pagSize, " | LastId: ", lastId
	write !,"---------------------------------------------------------"
	;
	for i=1:1:lista.Count() {
		set vo = lista.GetAt(i)
		write !,"  Classe : ", vo.Classe, " | Metodo: ", vo.Metodo
		write !,"  Inicio : ", vo.Inicio
		write !,"  Fim    : ", vo.Fim
		write !,"  Status : ", vo.Status, " | StatusProcesso: ", vo.StatusProcesso
		write !,"---------------------------------------------------------"
	}
	;
	write !,"Registros nesta pagina: ", lista.Count()
	if lista.Count() = pagSize {
		write !,"Proximo LastId para proxima pagina: ", ultimoId
	} else {
		write !,"Ultima pagina atingida."
	}
	quit

	;
	; 15 - Busca um log pelo ID e retorna objeto dinamico JSON
	;
BuscarLogPorIdJSON()	;
	;
	set log     = ##class(Treinamento.Data.LogMensagem).CriarEntrada("BuscarLogPorIdJSON", "ExercicioLog")
	set idLog   = log.%Id()
	write !,"Log criado para teste - ID: ", idLog
	;
	set json = ##class(Treinamento.Data.LogMensagem).BuscarLogPorIdJSON(idLog)
	;
	if $isObject(json) {
		write !,"Log encontrado em JSON:"
		write !,"  ID             : ", json.ID
		write !,"  Metodo         : ", json.Metodo
		write !,"  Classe         : ", json.Classe
		write !,"  Inicio         : ", json.Inicio
		write !,"  Fim            : ", json.Fim
		write !,"  Status         : ", json.Status
		write !,"  StatusProcesso : ", json.StatusProcesso
		write !,"JSON serializado: ", json.%ToJSON()
	} else {
		write !,"Log nao encontrado para ID: ", idLog
	}
	quit

	;
	; 16 - Consulta logs com paginacao e retorna estrutura JSON
	;
ConsultaLogPaginacaoJSON()	;
	;
	set status  = "Ativo"
	set lastId  = 0
	set pagSize = 3
	set dataFim = $zdatetime($horolog+1, 3)
	;
	set json = ##class(Treinamento.VO.LogMensagem).ConsultaLogPaginacaoJSON(status, lastId, pagSize, dataFim)
	;
	if '$isObject(json) {
		write !,"Erro ao consultar logs."
		quit
	}
	;
	write !,"=== Consulta de Log com Paginacao JSON ==="
	write !,"Status: ", status, " | Ate: ", dataFim, " | PagSize: ", pagSize, " | LastId: ", lastId
	write !,"---------------------------------------------------------"
	;
	set itens = json.Itens
	for i=0:1:itens.%Size()-1 {
		set item = itens.%Get(i)
		write !,"  ID     : ", item.ID
		write !,"  Classe : ", item.Classe, " | Metodo: ", item.Metodo
		write !,"  Inicio : ", item.Inicio
		write !,"  Fim    : ", item.Fim
		write !,"  Status : ", item.Status, " | StatusProcesso: ", item.StatusProcesso
		write !,"---------------------------------------------------------"
	}
	;
	write !,"Total nesta pagina: ", json.Total
	if json.ProximoLastId '= "" {
		write !,"Proximo LastId para proxima pagina: ", json.ProximoLastId
	} else {
		write !,"Ultima pagina atingida."
	}
	write !,"JSON serializado: ", json.%ToJSON()
	quit
